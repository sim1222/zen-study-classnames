{
	"name": "@sim1222/zen-study-classnames",
	"version": "0.1.1",
	"description": "Auto-generated stable references to ZEN Study's hashed CSS class names",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sim1222/zen-study-classnames.git"
	},
	"type": "module",
	"packageManager": "bun@1.3.14",
	"sideEffects": false,
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"files": [
		"dist"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"login": "bun scripts/login.ts",
		"extract": "bun scripts/extract.ts",
		"build": "bun run build:js && bun run build:types",
		"build:js": "bun build src/index.ts --outdir dist --target browser --format esm",
		"build:types": "tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"check:biome": "biome check --write .",
		"test": "bun test",
		"prepack": "bun run check && bun run test && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/bun": "1.3.14",
		"playwright": "1.62.1",
		"typescript": "7.0.2"
	}
}
